{
  "manifest_version": 3,
  "name": "Open Arcade \u2014 Video Studio",
  "version": "0.5.0",
  "description": "Turn Chrome tab recordings into polished videos. Smooth zoom, playful cursors, backgrounds, audio, and fast local MP4 export.",
  "minimum_chrome_version": "130",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen",
    "unlimitedStorage",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Arcade",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start recording this tab, or pause and resume"
    },
    "stop-recording": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Finish recording and open editor"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
